{
  "name": "nezumi-subscription",
  "version": "1.0.28",
  "description": "透明悬浮的本地账号与订阅管理桌面应用",
  "main": "src/main/main.cjs",
  "author": "账耗",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check src/main/main.cjs && node --check src/main/store.cjs && node --check src/main/preload.cjs && node --check src/shared/domain.cjs && node --check src/shared/exchange-rates.cjs && node --check src/shared/workbook.cjs && node --check src/shared/window-shape.cjs && node --check src/renderer/renderer.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.nezumi.subscription",
    "productName": "账耗",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "账耗-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "账耗"
    }
  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
